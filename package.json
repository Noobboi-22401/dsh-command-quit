{
  "name": "dsh-command-quit",
  "version": "1.1.0",
  "description": "DSH slash command that closes the DeepSeek Harness desktop client, with a configurable command name",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "slash-command",
    "quit"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml",
    "fix-quit.cmd",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "author": "Noobboi-22401",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Noobboi-22401/dsh-command-quit.git"
  },
  "homepage": "https://github.com/Noobboi-22401/dsh-command-quit#readme",
  "bugs": {
    "url": "https://github.com/Noobboi-22401/dsh-command-quit/issues"
  }
}
